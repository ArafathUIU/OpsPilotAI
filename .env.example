# Application
PROJECT_NAME="OpsPilot AI"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Database (PostgreSQL + pgvector)
# For local Docker Compose:
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="opspilot"
POSTGRES_PASSWORD="opspilot_secret_password"
POSTGRES_DB="opspilot_db"
DATABASE_URL="postgresql+asyncpg://opspilot:opspilot_secret_password@localhost:5432/opspilot_db"
# Fallback SQLite URL for offline unit testing without Docker:
# DATABASE_URL="sqlite+aiosqlite:///./opspilot_dev.db"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# LLM Providers (Configure at least one for multi-agent reasoning)
OPENAI_API_KEY="sk-mock-openai-key"
OPENAI_MODEL="gpt-4o"
OPENAI_FAST_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Security & Permissions
SECRET_KEY="ops-pilot-super-secret-production-quality-signing-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Budget & Safety Thresholds
MAX_AGENT_ITERATIONS=3
MAX_INCIDENT_TOKENS=50000
MAX_RETRIEVED_DOCUMENTS=3
DEFAULT_INVESTIGATION_TIMEOUT_SECONDS=60
